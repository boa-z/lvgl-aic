menu "ArtInChip LVGL 9.6 port"

config AIC_LVGL_PORT
    bool "ArtInChip LVGL 9.6 platform port"
    default y
    depends on !LPKG_USING_LVGL
    depends on KERNEL_RTTHREAD
    depends on LPKG_MPP

config AIC_LVGL_USE_DISPLAY
    bool "Enable ArtInChip display integration"
    default y
    depends on AIC_LVGL_PORT
    depends on LPKG_MPP

config AIC_LVGL_DISPLAY_ROTATION
    int "Display rotation (0=0, 1=90, 2=180, 3=270 degrees)"
    default 0
    range 0 3
    depends on AIC_LVGL_USE_DISPLAY
    help
      Application-owned display rotation. Allocates a CMA rotation buffer.
      GE2D is used when available; unsupported geometry uses software.

config AIC_LVGL_USE_TOUCH
    bool "Enable ArtInChip touch integration"
    default y
    depends on AIC_LVGL_PORT
    depends on AIC_LVGL_USE_DISPLAY
    depends on KERNEL_RTTHREAD

config AIC_LVGL_TOUCH_DEVICE
    string "Touch device name override"
    default ""
    depends on AIC_LVGL_USE_TOUCH
    help
      Leave empty to use the board-provided AIC_TOUCH_PANEL_NAME macro.
      Luban-Lite generates AIC_LVGL_TOUCH_DEVICE in rtconfig.h without a
      CONFIG_ prefix.

config AIC_LVGL_USE_ENCODER
    bool "Enable optional encoder integration"
    default n
    depends on AIC_LVGL_PORT
    depends on KERNEL_RTTHREAD

config AIC_LVGL_USE_MOUSE
    bool "Enable optional mouse integration"
    default n
    depends on AIC_LVGL_PORT
    depends on KERNEL_RTTHREAD

config AIC_LVGL_USE_GE2D
    bool "Enable ArtInChip GE2D draw unit"
    default n
    depends on AIC_LVGL_PORT
    depends on LPKG_MPP

config AIC_LVGL_USE_MPP_DEC
    bool "Enable ArtInChip MPP image decoder"
    default n
    depends on AIC_LVGL_PORT
    depends on LPKG_MPP

config AIC_LVGL_MPP_CACHE_BYTES
    int "MPP decoded-image cache budget (bytes; zero disables)"
    default 524288
    range 0 8388608
    depends on AIC_LVGL_USE_MPP_DEC
    help
        Application-owned LRU cache, at most 16 entries. Active decoder users
        are never evicted. Explicitly invalidate mutable sources before reuse.

config AIC_LVGL_USE_FREETYPE
    bool "Enable native LVGL FreeType bitmap fonts"
    default n
    depends on AIC_LVGL_PORT
    select LPKG_USING_FREETYPE
    help
        Use upstream LVGL 9.6 fonts and its glyph cache. The SDK supplies only
        the FreeType library; no legacy lvgl-ui font adapter is linked.

config AIC_LVGL_FREETYPE_GLYPHS
    int "FreeType cached glyph count per font cache"
    default 64
    range 8 512
    depends on AIC_LVGL_USE_FREETYPE

config AIC_LVGL_USE_GIF
    bool "Enable native LVGL GIF widget"
    default n
    depends on AIC_LVGL_PORT
    help
        Use the upstream LVGL 9.6 animated GIF widget. The application owns
        the source file and the GIF object lifetime; no SDK decoder is linked.

config AIC_LVGL_USE_FT_CACHE
    bool "Enable optional ArtInChip FreeType cache"
    default n
    depends on AIC_LVGL_PORT
    depends on LPKG_USING_FREETYPE

config AIC_LVGL_DEBUG_STATS
    bool "Enable lvgl-aic platform statistics"
    default n
    depends on AIC_LVGL_PORT

config AIC_LVGL_MANUAL_TEST
    bool "Build the platform-only manual LVGL test page"
    default n
    depends on AIC_LVGL_PORT

config AIC_LVGL_USE_IMG_ROLLER
    bool "Enable ArtInChip image roller adapted for LVGL 9.6"
    default n
    depends on AIC_LVGL_PORT

config AIC_LVGL_USE_SWIPE_V1
    bool "Enable ArtInChip four-position swipe adapted for LVGL 9.6"
    default n
    depends on AIC_LVGL_PORT

config AIC_LVGL_USE_VIDEO_WINDOW
    bool "Enable ArtInChip transparent video window for LVGL 9.6"
    default n
    depends on AIC_LVGL_PORT && AIC_LVGL_USE_GE2D && AIC_LVGL_USE_MPP_DEC
    help
        Alpha-zero replacement rectangle for a lower video layer. This widget
        does not open a camera, start a player or configure a display layer.

config AIC_LVGL_USE_VIN
    bool "Build application-owned VIN capture session support"
    default n
    depends on AIC_LVGL_PORT && AIC_MPP_VIN && AIC_DVP_DRV && AIC_USING_CAMERA
    help
        Internal capture lifecycle and explicit frame leases. The application
        must exclusively own VIN; camera widget integration is a separate layer.

endmenu

config AIC_LVGL_USE_CAMERA
    bool "Enable application-owned asynchronous camera image widget"
    default n
    depends on AIC_LVGL_USE_VIN
    help
        Camera control with worker-owned VIN capture and immutable YUV images.
        Explicit application colorimetry and YUV decoder initialization required.
        Uses LVGL composition, not the SDK lower video plane or barcode backend.

config AIC_LVGL_USE_APNG
    bool "Build asynchronous application-owned APNG playback"
    default n
    depends on AIC_LVGL_PORT && LPKG_MPP && AIC_VE_DRV
    help
        Bounded APNG parsing, MPP PNG decode, RGBA composition and timing.
        Independent of SDK player/audio. Pause, rational rate and replay are
        available through a worker and immutable RGB frame publication.
        Native file paths and explicit memory budgets are required.
        Up to four independent APNG instances share serialized SDK decode.
        Closing instances keep reservations until all image readers release.
        Enable the separate APNG image widget option for LVGL integration.

config AIC_LVGL_USE_APNG_WIDGET
    bool "Build asynchronous LVGL APNG image widget"
    default n
    depends on AIC_LVGL_USE_APNG
    help
        Application-owned image widget with source replacement, playback,
        pause, rational rate, replay and asynchronous deletion cleanup.

config AIC_LVGL_USE_PLAYER_SESSION
    bool "Build application-owned background media playback"
    default n
    depends on AIC_LVGL_PORT && AIC_MPP_PLAYER_INTERFACE && AIC_MPP_PLAYER_VIDEO_EXT_RENDER
    help
        Worker-side playback session, bounded CMA allocator and immutable
        RGB/YUV frame publication bridge with deferred decoder-frame return,
        coherent SDK events and an asynchronous prepare/start/pause/volume/
        close/seek worker. Uses SDK external-render timing, not a second scheduler.
        Seek drains readers and rebuilds the SDK session. No video-plane ownership.

config AIC_LVGL_USE_PLAYER
    bool "Build asynchronous LVGL player widget"
    default n
    depends on AIC_LVGL_USE_PLAYER_SESSION
    help
        RGB/YUV image widget with deferred source replacement, playback,
        pause/resume, seek, stop/replay, guarded auto-restart, volume, slave widgets and
        asynchronous deletion cleanup.
        Explicit CMA budget and RGB/YUV decoder initialization required.

config AIC_LVGL_USE_VIDEO_PLANE
    bool "Enable explicit native video-plane sessions"
    depends on AIC_LVGL_PORT
    default n
    help
        Owner-thread native RGB/YUV frame scanout with exclusive ownership and
        deferred release after VSync. Does not automatically change UI alpha
        or bind a widget. Do not combine with unmanaged video-layer writers.
